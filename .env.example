# ==================== Django ====================
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ==================== Database (PostgreSQL) ====================
POSTGRES_DB=ww3
POSTGRES_USER=ww3
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0

# ==================== Game config (معادل ww3/config.py) ====================
# توکن ربات تلگرام — برای Telegram Login و ارسال اعلان به ربات
BOT_TOKEN=
BOT_USERNAME=WWar3_bot
# توکن ربات برای verify هش Telegram Login Widget (خالی = BOT_TOKEN)
TELEGRAM_LOGIN_BOT_TOKEN=
# آیدی ادمین اصلی تلگرام
MAIN_ADMIN_ID=0

# ==================== Frontend ====================
VITE_API_BASE=
VITE_WS_HOST=
VITE_TELEGRAM_BOT=

# ==================== Misc ====================
HTTP_PORT=8080
TIME_ZONE=Asia/Tehran
